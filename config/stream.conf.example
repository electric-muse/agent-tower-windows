# agent-tower 播报调参 (key=value)。未列出的键使用内置默认值。
# 从 stream.conf.example 复制为 stream.conf 后按需覆盖

# 工具卡开关: 0=只播消息卡(安静模式)
tools=1

# 扫描间隔秒 / webhook消息最小间隔秒 / API 限速间隔秒
poll=1.0
gap=1.0
api_gap=0.3

# 每张卡片正文最大长度（超出完整分卡，不截尾；事件开始投递后冻结长度）
max_len=2000
# 仅结果模式：无来源结束信号时，静默后发送标注“未确认结束”的摘要
result_idle_seconds=60

# 会话活跃窗口(小时): 只播窗口内有写入的会话, 防历史刷屏
window_h=8

# 段卡: 1=开启工具段卡, 0=关; 每会话每批最多段数(超批次轮换)
seg_mode=1
seg_max=25

# 1=仅播报 #watch 已纳管会话及塔台创建的任务；0=播报所有活跃会话
watched_only=0

# 段卡 PATCH 最小间隔秒(思考期间多条命令并进同卡)
live_gap=2.5
