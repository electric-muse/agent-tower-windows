<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板: render_launchd.py 注入实际仓库、家目录和用户名 -->
<plist version="1.0"><dict>
<key>Label</key><string>com.__USER__.agent-tower</string>
<key>ProgramArguments</key><array>
<string>__ROOT__/.venv/bin/python</string>
<string>__ROOT__/scripts/tower.py</string>
</array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>10</integer>
<key>ProcessType</key><string>Background</string>
<key>WorkingDirectory</key><string>__HOME__</string>
<key>StandardOutPath</key><string>__ROOT__/logs/towerd.out</string>
<key>StandardErrorPath</key><string>__ROOT__/logs/towerd.err</string>
</dict></plist>
